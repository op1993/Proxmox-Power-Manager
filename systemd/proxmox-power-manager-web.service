[Unit]
Description=Proxmox Power Manager Web UI
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
EnvironmentFile=/etc/proxmox-power-manager/web.env
ExecStart=/usr/bin/python3 /opt/proxmox-power-manager/web/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/etc/proxmox-power-manager /root/.ssh
[Install]
WantedBy=multi-user.target
